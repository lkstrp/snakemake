"""Cache hits for directory outputs: no double symlink, no stale timestamp."""


rule all:
    input:
        "file_after/dir/a.txt",
        "file_before/dir/a.txt",


rule make_input:
    output:
        "in.txt",
    run:
        with open(output[0], "w") as f:
            f.write("in\n")


rule file_after_dir:
    input:
        "in.txt",
    output:
        dir=directory("file_after/dir"),
        file="file_after/dir/a.txt",
    params:
        order="after",
    cache: True
    run:
        os.makedirs(output.dir, exist_ok=True)
        for name in ("a.txt", "b.txt"):
            with open(f"{output.dir}/{name}", "w") as f:
                f.write(f"{name}\n")


rule file_before_dir:
    input:
        "in.txt",
    output:
        file="file_before/dir/a.txt",
        dir=directory("file_before/dir"),
    params:
        order="before",
    cache: True
    run:
        os.makedirs(output.dir, exist_ok=True)
        for name in ("a.txt", "b.txt"):
            with open(f"{output.dir}/{name}", "w") as f:
                f.write(f"{name}\n")
